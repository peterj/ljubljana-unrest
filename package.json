{
  "name": "ljubljana-unrest",
  "version": "1.0.0",
  "description": "Crowd strategy game in the streets of Ljubljana (Three.js WebGPU)",
  "private": true,
  "dependencies": {
    "three": "^0.186.1",
    "tone": "^15.1.22",
    "vite": "^8.3.4"
  },
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc -p . && tsc -p tsconfig.sdk.json",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "build:city": "python tools/build_city.py"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2"
  }
}
